// .gitignore
# Build outputs
/build/
/dist/

# Dependencies
/node_modules/

# Environment variables (consider which ones to ignore)
*.local
.env
.env.local
.env.*.local
.env.development
.env.production

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
ui-debug.log*

# OS files
.DS_Store
Thumbs.db

# Firebase cache
/.firebase/
/firebase/emulator-data/*

# Docker data
/docker/emulators/data/
/docker/emulators/logs/
*.log

# IDE specific files
/.idea/
/.vscode/
.claude/settings.local.json

coverage

# Test reports
/test-reports/

/scripts/*
# One-off data-migration artefacts written into the repo root by
# src/utils/__dev__/normalizeChapterDateModified.ts. Audit reports list document
# paths; migrate journals contain the before/after values used for rollback.
# Keep them locally while a pass is in flight -- never commit them.
chapter-dateModified-audit-*.json
chapter-dateModified-journal-*.ndjson
